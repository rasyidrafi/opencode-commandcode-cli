{
  "name": "opencode-commandcode-cli",
  "version": "0.1.0",
  "description": "OpenCode provider adapter that runs the official Command Code CLI",
  "license": "MIT",
  "type": "module",
  "main": "./opencode-commandcode-cli.js",
  "module": "./opencode-commandcode-cli.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./opencode-commandcode-cli.js",
      "default": "./opencode-commandcode-cli.js"
    }
  },
  "files": [
    "dist",
    "opencode-commandcode-cli.js",
    "README.md"
  ],
  "scripts": {
    "prebuild": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test test/smoke.mjs",
    "test:live": "npm run build && node test/live.mjs",
    "prepublishOnly": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rasyidrafi/opencode-commandcode-cli.git"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "command-code",
    "commandcode",
    "cli",
    "agent",
    "provider"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.47",
    "@opencode-ai/plugin": "^1.18.26"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/node": "^22.15.0",
    "typescript": "^5.9.3"
  }
}
